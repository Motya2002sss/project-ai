{
  "expo": {
    "name": "AI Life Planner",
    "slug": "ai-life-planner",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "ailifeplanner",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.ailifeplanner.mobile",
      "usesAppleSignIn": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-calendar",
        {
          "calendarPermission": "AI Life Planner видит только занятые интервалы, чтобы не ставить задачи поверх событий. Названия и заметки календаря не отправляются."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
